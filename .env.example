# Copy to .env and adjust if needed. NEVER commit a real .env file.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put private keys or secrets in a VITE_ variable.

# ---- Frontend (optional; defaults shown) ----
# RPC used for read-only blockchain access (works even without MetaMask).
VITE_RPC_URL=http://127.0.0.1:8545
# Chain ID MetaMask must be connected to (Hardhat local = 31337).
VITE_CHAIN_ID=31337
# Override the contract address. Normally leave empty: the deploy script writes
# src/contracts/VotingSystem.json with the address and ABI automatically.
VITE_CONTRACT_ADDRESS=

# ---- Hardhat / deploy script (optional) ----
LOCAL_RPC_URL=http://127.0.0.1:8545
ELECTION_NAME=Student Council Election 2026
# "true" (default) adds 4 demo candidates and registers Hardhat accounts #1-#5 as voters.
SEED_DEMO=true
